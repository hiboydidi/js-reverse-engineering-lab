{
  "name": "JS Reverse Engineering Lab",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-24-bookworm",
  "forwardPorts": [5173, 3000],
  "portsAttributes": {
    "5173": {
      "label": "实验室前端",
      "onAutoForward": "openBrowser"
    },
    "3000": {
      "label": "本地模拟 API"
    }
  },
  "postCreateCommand": "npm ci && npx playwright install chromium",
  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint", "esbenp.prettier-vscode", "ms-playwright.playwright"]
    }
  }
}
